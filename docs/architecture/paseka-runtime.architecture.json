      "title": "Primary path",
      "items": [
        "POST /api/cues/:id/run publishes SIGNAL or task.plan",
        "Reactor applies the ledger, then Prepare → Run → Finalize"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ownership",
      "items": [
        ".paseka/ is committed; worktrees/ and runs/ are gitignored",
        "Apiary ~/.config/paseka/<slug>/ holds secrets and state.json"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and side paths",
      "items": [
        "Console has no auth — localhost or VPN only",
